# Cloudflare KV — required for the store stage.
# Without these (and CLOUDFLARE_KV_NAMESPACE_ID), the pipeline runs but does
# NOT persist anything to KV; the web runtime will see no data.
#
# Token-split rationale: the data pipeline needs a token that can
# WRITE to KV (and ideally read the manifest for the validate step).
# The web runtime only READS from KV. We use two different tokens so
# a leak of either one has the smallest possible blast radius:
#
#   * data token  — KV write (and read for the validate step).
#   * web token   — Pages edit + Workers KV read only (lives in web/.env;
#                   cannot overwrite the catalog).
#
# Both tokens share the same account id and namespace id by design.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

# Feishu / Lark webhook for pipeline summaries and failure alerts (optional).
# Without this, the notify stage is a no-op; critical failures will still be
# logged to stderr but no message will be sent.
# Create a custom bot webhook at https://open.feishu.cn
FEISHU_WEBHOOK_URL=

# Hugging Face router SOCKS5 proxy (local dev only).
# Leave empty on GitHub Actions runner (direct access); set to a SOCKS5 URL like
# socks5h://127.0.0.1:7897 when running locally where router.huggingface.co
# is unreachable. Requires PySocks (`pip install PySocks`).
SOCKS5_PROXY=