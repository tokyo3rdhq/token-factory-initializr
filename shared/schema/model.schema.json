{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelEndpoint",
  "description": "Canonical model endpoint schema for the Free Model Aggregator.",
  "type": "object",
  "required": [
    "provider",
    "model_id",
    "free",
    "fetched_at"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "description": "Provider identifier: nvidia, amd, huggingface"
    },
    "model_id": {
      "type": "string",
      "description": "Provider-specific model identifier"
    },
    "name": {
      "type": ["string", "null"],
      "description": "Human-readable model name"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Model description"
    },
    "free": {
      "type": "boolean",
      "description": "Whether this endpoint is free to use"
    },
    "capabilities": {
      "type": "object",
      "description": "Model capability flags (chat, tool_calling, vision, speech, embedding, etc.)"
    },
    "architecture": {
      "type": ["object", "null"],
      "description": "Input and output modalities. Field name matches HF router API convention (architecture.{input,output}_modalities); AMD mirrors via model.output + provider_pricing; NVIDIA derives from capabilities.",
      "properties": {
        "input": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Modalities the model accepts (e.g. text, image, audio)"
        },
        "output": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Modalities the model emits (e.g. text, image, audio, tool_calls, embedding)"
        }
      },
      "additionalProperties": false
    },
    "lab": {
      "type": ["string", "null"],
      "description": "Lab / organization the model is attributed to (HF: owned_by, AMD: token_factory.publisher.name)."
    },
    "metadata": {
      "type": "object",
      "description": "Provider-specific metadata"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this endpoint was fetched"
    },
    "canonical_model_id": {
      "type": ["string", "null"],
      "description": "Future: canonical model identity across providers"
    },
    "model_family": {
      "type": ["string", "null"],
      "description": "Future: model family grouping"
    },
    "organization": {
      "type": ["string", "null"],
      "description": "Future: organization name"
    },
    "version": {
      "type": ["string", "null"],
      "description": "Future: model version"
    },
    "context_length": {
      "type": ["integer", "null"],
      "description": "Future: context window size"
    },
    "license": {
      "type": ["string", "null"],
      "description": "Future: model license"
    },
    "quantization": {
      "type": ["string", "null"],
      "description": "Future: quantization method"
    },
    "pricing": {
      "type": ["object", "null"],
      "description": "Future: pricing information"
    },
    "endpoint_url": {
      "type": ["string", "null"],
      "description": "Future: direct endpoint URL"
    },
    "region": {
      "type": ["string", "null"],
      "description": "Future: deployment region"
    },
    "status": {
      "type": ["string", "null"],
      "description": "Future: endpoint health status"
    },
    "limits": {
      "type": ["object", "null"],
      "description": "Future: rate limits"
    },
    "score": {
      "type": ["number", "null"],
      "description": "Future: quality/performance score"
    }
  },
  "additionalProperties": false
}