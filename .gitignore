# Test fixtures — provider payloads (JSON / HTML) are downloaded live by
# `python -m tests.download_fixtures`. They are not source files; committing
# them just bloats the repo and creates stale snapshots. The ``__init__.py``
# is exempt (not a payload) so the fixtures package still imports.
data/tests/fixtures/*.json
data/tests/fixtures/*.html
