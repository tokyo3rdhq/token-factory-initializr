# Cloudflare KV — required for the web runtime (Pages Functions) to read
# the catalog produced by the data pipeline. Copy this file to ``.env``
# and fill in the values, or set the same variables in your shell.
#
# Without these:
#   * ``wrangler pages dev`` runs but ``/api/*`` returns 404 (KV empty).
#   * ``wrangler pages deploy`` succeeds but the deployed site shows
#     "no data" until the data pipeline runs against the same namespace.
#
# Get the values from:
#   * account id  — Cloudflare dashboard → right sidebar
#   * api token   — dash.cloudflare.com → "My Profile" → "API Tokens"
#                   (template "Edit Cloudflare Workers" works for KV)
#   * namespace   — ``wrangler kv namespace list`` (existing one named
#                   ``magi-kv`` is what the data pipeline uses)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=0d4734eae9ce4b5d9ad4fa32e6ef462c

# When set to "1", Pages Functions skip KV lookups and serve the bundled
# fixture file (web/src/data/fixtures.json). Useful when KV is empty
# (e.g. fresh clone before the data pipeline has run). Defaults to "0"
# so production deployments always hit the live KV.
TFI_USE_LOCAL_FIXTURES=0