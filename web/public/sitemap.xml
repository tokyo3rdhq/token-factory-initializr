<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml for Token Factory Initializr.

  Per docs/tfi_seo_optimization.md §9:
    - only canonical, indexable URLs
    - exclude /api/* /generated/* /llms.txt /agents.md

  Static sitemap — the set of indexable routes is fixed (homepage
  + /browse). No runtime/KV dependency; works when KV is unreachable.

  Generated by hand to keep the build deterministic and to avoid
  pulling in a sitemap library for a 2-URL file. If TFI grows more
  indexable routes later, switch to a Pages Function that emits
  this file with the same XML structure.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://start.magi.website/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://start.magi.website/browse</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>